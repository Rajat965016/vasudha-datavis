# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Comma separated list of origins allowed to call this API.
# Use * only for quick local experiments.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/vasudha_datavis
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/vasudha_datavis?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/vasudha_datavis

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Use a long random string in production, e.g. `openssl rand -hex 48`
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
# Minutes a password-reset link stays valid
PASSWORD_RESET_TTL_MINUTES=30

# ---------------------------------------------------------------------------
# Default Super Admin (created by `npm run seed`)
# ---------------------------------------------------------------------------
SUPER_ADMIN_NAME=Vasudha Super Admin
SUPER_ADMIN_EMAIL=superadmin@vasudhaindia.org
SUPER_ADMIN_PASSWORD=Admin@123

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
MAX_DATASET_ROWS=20000

# ---------------------------------------------------------------------------
# Email (optional – bonus feature)
# Leave SMTP_HOST empty to disable outbound mail. The app then logs the
# message to the console instead of failing, so every other feature keeps
# working without an SMTP account.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Vasudha Data Platform <no-reply@vasudhaindia.org>"

# Public URL of the deployed frontend – used to build password reset links
FRONTEND_URL=http://localhost:5173
