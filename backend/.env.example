# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Comma separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# PostgreSQL database
# ---------------------------------------------------------------------------
# Either set DATABASE_URL (takes priority) …
# DATABASE_URL=postgresql://user:password@host:5432/vasudha_datavis
#
# … or the individual settings below.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vasudha_datavis
DB_USER=postgres
DB_PASSWORD=postgres_dev_pw

# Set to true when the provider requires TLS (cloud PostgreSQL hosts like Render require this).
DB_SSL=false
# Providers that sign with their own CA (Aiven, for example) publish a CA
# certificate — paste its PEM contents here to keep verification switched on.
# Use \n for line breaks if your host's UI does not accept multi-line values.
DB_SSL_CA=
# Last resort for a provider whose certificate cannot be verified.
DB_SSL_REJECT_UNAUTHORIZED=true

# Connection pool
DB_POOL_MAX=10
DB_POOL_MIN=0

# Log every SQL statement (noisy — development only)
DB_LOGGING=false

# Create/update tables automatically on boot. Handy for a first deploy;
# use `npm run db:sync` or database/schema.sql for anything more controlled.
DB_SYNC=true

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Use a long random string in production, e.g. `openssl rand -hex 48`
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
# Minutes a password-reset link stays valid
PASSWORD_RESET_TTL_MINUTES=30

# ---------------------------------------------------------------------------
# Default Super Admin (created automatically on first boot)
# ---------------------------------------------------------------------------
SUPER_ADMIN_NAME=Vasudha Super Admin
SUPER_ADMIN_EMAIL=superadmin@vasudhaindia.org
SUPER_ADMIN_PASSWORD=Admin@123

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
MAX_DATASET_ROWS=20000

# ---------------------------------------------------------------------------
# Email (optional – bonus feature)
# Leave SMTP_HOST empty to disable outbound mail. The app then logs the
# message instead of failing, so every other feature keeps working.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Vasudha Data Platform <no-reply@vasudhaindia.org>"

# Public URL of the deployed frontend – used to build password reset links
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Auth throttling
# ---------------------------------------------------------------------------
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=20
